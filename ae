#!/bin/bash
# ae - drive Adobe After Effects from the shell (macOS). See README.md next to this file.
#   ae run script.jsx [--log file] [--ro|--undo] [--timeout s]
#   ae eval 'js' [--ro]            ae check script.jsx
#   ae dump "Comp" [--depth N] [--layer name] [--no-keys] [--max-keys N] [--raw-text]
#   ae tree [--main "Comp"]         (default: the active comp)
#   ae snap "Comp" 8,44,90|10-100:10 [--out dir] [--prefix p] [--res full|half|third|quarter] [--sheet] [--cols N] [--width px]
#   ae sheet out.png a.png b.png ... [--cols N] [--width px]
#   ae frames video.mp4 [--n 12] [--cols 4] [--width 480] [--from s] [--to s] [--out sheet.png]
#   ae probe video.mp4 [--fps N]    (--fps: also the length in comp frames at N fps)
#   ae save [--backup] [--status] [--as file.aep]
#   ae doctor                       check node/ffmpeg/AE/permissions/prefs      ae selftest [--keep]
# Exit codes: 0 ok, 1 script logged ERR, 2 usage/syntax/lint error, 3 AE not running / timeout.
shopt -s nullglob

# AE app name: $AE_APP, else the running instance, else the newest one installed in /Applications
detect_app() {
  local p
  p="$(ps -axo comm= 2>/dev/null | grep -m1 '/Contents/MacOS/After Effects$')"
  if [ -n "$p" ]; then p="${p%.app/Contents/MacOS/*}"; echo "${p##*/}"; return; fi
  for p in /Applications/Adobe\ After\ Effects*/Adobe\ After\ Effects*.app; do
    case "$p" in *"Render Engine"*) continue ;; esac
    p="${p%.app}"; echo "${p##*/}"
  done | sort | tail -1
}
AE_APP="${AE_APP:-$(detect_app)}"
AE_APP="${AE_APP:-Adobe After Effects 2026}"
WORK="${AE_TMP:-${TMPDIR:-/tmp}}"; WORK="${WORK%/}/ae-tools"
RUN_TIMEOUT="${AE_TIMEOUT:-300}"      # seconds to wait for a script's log
SNAP_TIMEOUT="${AE_SNAP_TIMEOUT:-60}" # seconds to wait for async PNGs
FONT=""
for f in /System/Library/Fonts/Supplemental/Arial.ttf /System/Library/Fonts/Helvetica.ttc /Library/Fonts/Arial.ttf; do
  [ -f "$f" ] && { FONT="$f"; break; }
done

# resolve our real location (works through symlinks; macOS readlink has no -f on old systems)
SRC="${BASH_SOURCE[0]}"
while [ -h "$SRC" ]; do
  D="$(cd -P "$(dirname "$SRC")" && pwd)"; SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$D/$SRC" ;; esac
done
TOOLS="$(cd -P "$(dirname "$SRC")" && pwd)"
LIB="$TOOLS/lib.jsx"

die() { echo "ae: $*" >&2; exit 2; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found"; }
abspath() { case "$1" in /*) echo "$1" ;; *) echo "$PWD/$1" ;; esac; }

# ---------------------------------------------------------------- node helper (syntax check, lint, prep)
read -r -d '' NODE_JS <<'NODEEOF'
const fs = require('fs'), vm = require('vm'), path = require('path');
const [mode, ...args] = process.argv.slice(1);
const RESERVED = 'in|do|if|for|new|var|try|case|else|enum|null|this|true|void|with|break|catch|class|const|false|super|throw|while|delete|export|import|return|switch|typeof|extends|finally|continue|debugger|function|instanceof';
function jsstr(s) { return JSON.stringify(String(s)).replace(/[\u007f-\uffff]/g, c => '\\u' + c.charCodeAt(0).toString(16).padStart(4, '0')); }
const PRE = /^\s*(#|\/\/@)(include|includepath|target|targetengine|script|strict|engine)\b/;
// blank out comments, string contents and regex literals, keeping newlines/columns
function strip(s) {
  let o = '', i = 0, n = s.length, prev = '';
  while (i < n) {
    const c = s[i], d = s[i + 1];
    if (c === '/' && d === '/') { while (i < n && s[i] !== '\n') { o += ' '; i++; } continue; }
    if (c === '/' && d === '*') { o += '  '; i += 2; while (i < n && !(s[i] === '*' && s[i + 1] === '/')) { o += s[i] === '\n' ? '\n' : ' '; i++; } o += '  '; i += 2; continue; }
    if (c === '"' || c === "'") { o += c; i++; while (i < n && s[i] !== c && s[i] !== '\n') { if (s[i] === '\\') { o += '  '; i += 2; continue; } o += ' '; i++; } o += c; i++; prev = 'a'; continue; }
    if (c === '`') { o += '`'; i++; while (i < n && s[i] !== '`') { if (s[i] === '\\') { o += '  '; i += 2; continue; } o += s[i] === '\n' ? '\n' : ' '; i++; } o += '`'; i++; prev = 'a'; continue; }
    if (c === '/') {
      const lw = /([A-Za-z_$]+)\s*$/.exec(o.slice(-40));
      const isRe = prev === '' || /[(,=:\[!&|?{};+\-*%<>~^]/.test(prev) || (lw && /^(return|typeof|in|of|case|else|void|delete|new|instanceof)$/.test(lw[1]) && /[A-Za-z_$]/.test(prev));
      if (isRe) { o += '/'; i++; let cls = false; while (i < n && s[i] !== '\n') { if (s[i] === '\\') { o += '  '; i += 2; continue; } if (s[i] === '[') cls = true; else if (s[i] === ']') cls = false; else if (s[i] === '/' && !cls) break; o += ' '; i++; } o += '/'; i++; prev = 'a'; continue; }
    }
    o += c; if (!/\s/.test(c)) prev = c; i++;
  }
  return o;
}
function lint(src, label) {
  const errs = [], warns = [];
  const lines = strip(src).split('\n');
  const E = [
    [/=>/, 'arrow function (ES6)'], [/`/, 'template literal (ES6)'],
    [/\b(let|const)\s+[A-Za-z_$\[{]/, 'let/const (ES6) - use var'], [/\bclass\s+[A-Za-z_$]/, 'class (ES6)'],
    [/\.\.\.\s*[A-Za-z_$\[{(]/, 'spread/rest (ES6)'], [/\bfor\s*\(\s*(var\s+)?[A-Za-z_$][\w$]*\s+of\s/, 'for...of (ES6)'],
    [/\basync\s+function\b|\bawait\s/, 'async/await'], [/\?\.[A-Za-z_$\[(]|\?\?/, 'optional chaining / ?? (ES2020)'],
    [/\*\*/, '** operator - use Math.pow'],
    [new RegExp('\\.\\s*(' + RESERVED + '|default)\\b'), 'reserved word as property (ExtendScript: "Illegal use of reserved word") - use o["in"]'],
    [new RegExp('[{,]\\s*(' + RESERVED.replace('case|', '') + ')\\s*:'), 'reserved word as bare object key - quote it: {"in": 1}'],
    [/\bexecuteCommand\s*\(/, 'app.executeCommand is forbidden (pitfall 2)'],
  ];
  const W = [
    [/(?<!\b(?:AE|A))\.(forEach|map|filter|reduce|some|every|find|findIndex|includes|startsWith|endsWith|trim|trimStart|trimEnd|padStart|padEnd|repeat)\s*\(/, 'ES5+ method, not in ExtendScript'],
    [/\bObject\.(keys|assign|entries|values|create|defineProperty|freeze)\b|\bArray\.(isArray|from|of)\b/, 'ES5+ builtin, not in ExtendScript'],
    [/\bapp\.project\.(save|saveWithDialog|close)\s*\(|\bapp\.(quit|newProject|open)\s*\(/, 'saves/closes/replaces the project'],
  ];
  lines.forEach((l, i) => {
    for (const [re, msg] of E) if (re.test(l)) errs.push(`${label}:${i + 1}: ERROR ${msg}\n    ${src.split('\n')[i].trim().slice(0, 160)}`);
    for (const [re, msg] of W) if (re.test(l)) warns.push(`${label}:${i + 1}: warning ${msg}\n    ${src.split('\n')[i].trim().slice(0, 160)}`);
  });
  return { errs, warns };
}
function check(src, label) {
  const blank = src.split('\n').map(l => PRE.test(l) ? '' : l).join('\n');
  try { new vm.Script('(function(){' + blank + '\n})', { filename: label }); }
  catch (e) { return { errs: ['SYNTAX ' + String(e.stack).split('\n').slice(0, 4).join('\n')], warns: [] }; }
  return lint(blank, label);
}
if (mode === 'jsstr') { process.stdout.write(jsstr(args[0])); }
else if (mode === 'isexpr') {
  try { new vm.Script('(function(){return (' + args[0] + '\n)})'); process.stdout.write('expr'); } catch (e) { process.stdout.write('stmt'); }
}
else if (mode === 'prep') {           // prep <in> <out> <lib>: check + rewrite includes
  const [inp, out, lib] = args;
  const src = fs.readFileSync(inp, 'utf8').replace(/^\uFEFF/, '');
  const label = path.basename(inp);
  const { errs, warns } = check(src, label);
  warns.forEach(w => console.error(w));
  if (errs.length) { errs.forEach(e => console.error(e)); process.exit(2); }
  const dir = path.dirname(path.resolve(inp));
  const res = src.split('\n').map(l => {
    const m = /^\s*(#|\/\/@)include\s+["']?([^"']+?)["']?\s*;?\s*$/.exec(l);
    if (!m) return l;
    const p = path.isAbsolute(m[2]) ? m[2] : path.resolve(dir, m[2]);
    if (path.basename(p) === 'lib.jsx' && (p === lib || fs.existsSync(p) && fs.realpathSync(p) === fs.realpathSync(lib))) return '';
    return '#include "' + p + '"';
  }).join('\n');
  fs.writeFileSync(out, res);
}
else { console.error('node helper: unknown mode ' + mode); process.exit(2); }
NODEEOF

nodejs() { node -e "$NODE_JS" "$@"; }
jsstr() { nodejs jsstr "$1"; }

# ---------------------------------------------------------------- AE plumbing
ae_running() { [ "$(osascript -e "application \"$AE_APP\" is running" 2>/dev/null)" = "true" ]; }

png_done() {  # complete PNG = non-empty and ends with the IEND chunk
  [ -s "$1" ] || return 1
  [ "$(tail -c 8 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "49454e44ae426082" ]
}

wait_pngs() {  # wait_pngs timeout path...
  local timeout=$1; shift
  [ $# -eq 0 ] && return 0
  local start=$SECONDS missing first=""
  while :; do
    missing=0
    for p in "$@"; do png_done "$p" || { missing=$((missing + 1)); }; done
    [ -z "$first" ] && first=$missing
    if [ $missing -eq 0 ]; then
      [ -n "${AE_DEBUG:-}" ] && echo "ae: PNGs: $first of $# missing at first check, all ready after $((SECONDS - start))s" >&2
      return 0
    fi
    if [ $((SECONDS - start)) -ge "$timeout" ]; then
      echo "ae: timeout: $missing of $# PNG(s) still missing after ${timeout}s:" >&2
      for p in "$@"; do png_done "$p" || echo "  $p" >&2; done
      return 3
    fi
    sleep 0.3
  done
}

# run_jsx <user.jsx> <log> <undo true|false> <label>   (QUIET=1: print log only on error)
# Builds <WORK>/run/<label>.combined.jsx = lib + wrapper + user code, runs it, waits for the log and any PNGs.
run_jsx() {
  local user="$1" log="$2" undo="$3" label="$4"
  need node; need osascript
  [ -f "$LIB" ] || die "lib.jsx not found next to ae ($LIB)"
  mkdir -p "$WORK/run" || die "cannot create $WORK/run"
  local base; base="$(basename "$user")"; base="${base%.jsx}"
  local prepped="$WORK/run/$base.prep.jsx" combined="$WORK/run/$base.combined.jsx"
  nodejs prep "$user" "$prepped" "$LIB" || { echo "ae: $user failed the syntax/lint check; not run" >&2; return 2; }
  ae_running || { echo "ae: '$AE_APP' is not running" >&2; return 3; }
  local liblines; liblines=$(wc -l < "$LIB" | tr -d ' ')
  local offset=$((liblines + 1))
  {
    printf 'try{'
    cat "$LIB"
    printf 'AE._begin(%s, %s, %d, %s);AE.run(%s, function (log) {\n' "$(jsstr "$log")" "$(jsstr "$user")" "$offset" "$(jsstr "$WORK")" "$(jsstr "$label")"
    cat "$prepped"
    printf '\n}, {undo: %s, silent: true});\nAE._end();\n' "$undo"
    printf '}catch(__e){var __f=new File(%s);__f.encoding="UTF-8";__f.lineFeed="Unix";__f.open("w");__f.write("ERR fatal (lib/wrapper): "+__e.message+" line "+__e.line+"\\n");__f.close();}\n' "$(jsstr "$log")"
  } > "$combined"
  mkdir -p "$(dirname "$log")"
  rm -f "$log" "$log.part"
  local out
  out=$(osascript -e 'on run argv' -e "tell application \"$AE_APP\" to DoScriptFile (item 1 of argv)" -e 'end run' "$combined" 2>&1) \
    || { echo "ae: osascript failed: $out" >&2; return 3; }
  local start=$SECONDS warned=0
  while [ ! -f "$log" ]; do
    if [ $((SECONDS - start)) -ge "$RUN_TIMEOUT" ]; then
      echo "ae: no log after ${RUN_TIMEOUT}s ($log). AE busy, or a modal dialog is open in AE? combined script: $combined" >&2
      return 3
    fi
    if [ $warned -eq 0 ] && [ $((SECONDS - start)) -ge 10 ]; then echo "ae: waiting for AE..." >&2; warned=1; fi
    sleep 0.2
  done
  local failed=0
  grep -q '^ERR' "$log" && failed=1
  if [ "${QUIET:-0}" = 1 ]; then
    [ $failed = 1 ] && cat "$log" >&2
  else
    cat "$log"
  fi
  # async PNGs queued by AE.snap
  local pngs=() line
  while IFS= read -r line; do pngs+=("${line#PNG }"); done < <(grep '^PNG ' "$log")
  if [ ${#pngs[@]} -gt 0 ]; then
    wait_pngs "$SNAP_TIMEOUT" "${pngs[@]}" || return 3
    [ "${QUIET:-0}" = 1 ] || echo "ae: ${#pngs[@]} PNG(s) ready" >&2
  fi
  [ $failed = 1 ] && return 1
  return 0
}

# ---------------------------------------------------------------- ffmpeg helpers
safe_label() { printf '%s' "$1" | tr -c 'A-Za-z0-9 ._#=+-' '_'; }

# make_sheet <out.png> <cols> <cellWidth> <label> <file> [<label> <file> ...]
make_sheet() {
  need ffmpeg; need ffprobe
  local out="$1" cols="$2" cw="$3"; shift 3
  local n=$(( $# / 2 ))
  [ $n -ge 1 ] || die "sheet: no images"
  local wh w h ch
  wh=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$2") || die "sheet: cannot read $2"
  w=${wh%%,*}; h=${wh#*,}; h=${h%%,*}
  ch=$(( (cw * h / w + 1) / 2 * 2 ))
  local fs=$(( ch / 12 )); [ $fs -lt 14 ] && fs=14
  local inputs=() fc="" layout="" stack="" i=0 label file dt
  while [ $# -gt 0 ]; do
    label="$(safe_label "$1")"; file="$2"; shift 2
    inputs+=(-i "$file")
    dt=""
    [ -n "$FONT" ] && dt=",drawtext=fontfile='$FONT':text='$label':x=8:y=8:fontsize=$fs:fontcolor=white:box=1:boxcolor=black@0.6:boxborderw=5"
    fc="$fc[$i:v]scale=$cw:$ch:force_original_aspect_ratio=decrease,pad=$cw:$ch:(ow-iw)/2:(oh-ih)/2:color=black$dt[v$i];"
    layout="$layout${layout:+|}$(( (i % cols) * cw ))_$(( (i / cols) * ch ))"
    stack="$stack[v$i]"
    i=$((i + 1))
  done
  if [ $n -eq 1 ]; then
    fc="${fc%;}"; fc="${fc%\[v0\]}[out]"
  else
    fc="${fc}${stack}xstack=inputs=$n:layout=$layout:fill=black[out]"
  fi
  mkdir -p "$(dirname "$out")"
  ffmpeg -v error -y "${inputs[@]}" -filter_complex "$fc" -map "[out]" -frames:v 1 -update 1 "$out" || die "ffmpeg failed building $out"
}

# ---------------------------------------------------------------- commands
# ---------------------------------------------------------------- save
# ae save            save the open project to its current file (not undoable; AE's own Save)
# ae save --status   only print path + unsaved-changes flag, save nothing
# ae save --backup   first copy the on-disk .aep to <dir>/Backups/<name>-YYYYmmdd-HHMMSS.aep, then save
# ae save --as f.aep save to a new file (AE then works on that file, like Save As)
cmd_save() {
  local backup=0 status=0 as=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --backup) backup=1; shift ;;
      --status) status=1; shift ;;
      --as) [ $# -ge 2 ] || die "save: --as needs a path"; as="$(abspath "$2")"; shift 2 ;;
      *) die "usage: ae save [--backup] [--status] [--as file.aep]" ;;
    esac
  done
  mkdir -p "$WORK/save"
  local f="$WORK/save/status.jsx" log="$WORK/save/status.log"
  printf 'var __p=app.project.file;log("PATH "+(__p?__p.fsName:""));log("DIRTY "+app.project.dirty);\n' > "$f"
  QUIET=1 run_jsx "$f" "$log" false "ae save status" || return $?
  local path dirty
  path="$(sed -n 's/^PATH //p' "$log")"; dirty="$(sed -n 's/^DIRTY //p' "$log")"
  echo "project: ${path:-<untitled>}"
  echo "unsaved changes: $dirty"
  [ $status = 1 ] && return 0
  if [ -z "$as" ]; then
    [ -n "$path" ] || die "project has never been saved; use: ae save --as /path/file.aep"
    if [ "$dirty" != "true" ]; then echo "nothing to save"; return 0; fi
  else
    case "$as" in *.aep|*.aepx) ;; *) die "--as path must end in .aep or .aepx" ;; esac
    [ -d "$(dirname "$as")" ] || die "folder does not exist: $(dirname "$as")"
  fi
  if [ $backup = 1 ] && [ -n "$path" ] && [ -f "$path" ]; then
    local bdir name stamp dest
    bdir="$(dirname "$path")/Backups"; name="$(basename "$path")"; stamp="$(date +%Y%m%d-%H%M%S)"
    dest="$bdir/${name%.*}-$stamp.${name##*.}"
    mkdir -p "$bdir" && cp -p "$path" "$dest" || die "backup failed ($dest); not saved"
    echo "backup: $dest"
  fi
  f="$WORK/save/save.jsx"; log="$WORK/save/save.log"
  if [ -n "$as" ]; then
    printf 'app.project.save(new File(%s));log("SAVED "+app.project.file.fsName);log("DIRTY "+app.project.dirty);\n' "$(jsstr "$as")" > "$f"
  else
    printf 'app.project.save();log("SAVED "+app.project.file.fsName);log("DIRTY "+app.project.dirty);\n' > "$f"
  fi
  QUIET=1 run_jsx "$f" "$log" false "ae save" || return $?
  local saved; saved="$(sed -n 's/^SAVED //p' "$log")"
  [ -n "$saved" ] && [ -f "$saved" ] || { echo "ae: save did not confirm (log: $log)" >&2; return 1; }
  echo "saved: $saved ($(du -h "$saved" | cut -f1 | tr -d ' '), $(date -r "$saved" '+%H:%M:%S'))"
  [ "$(sed -n 's/^DIRTY //p' "$log")" = "false" ] || echo "ae: warning: AE still reports unsaved changes" >&2
}

# ---------------------------------------------------------------- doctor / selftest
# ae doctor: checks everything a first run needs; prints ok/WARN/FAIL with the fix. Exit 1 on any FAIL.
# Read-only: the only thing it sends to AE is a script that logs the AE version.
cmd_doctor() {
  local fails=0 v
  ok() { echo "ok    $*"; }
  warn() { echo "WARN  $*"; }
  fail() { echo "FAIL  $*"; fails=$((fails + 1)); }

  if [ "$(uname -s)" = Darwin ]; then ok "macOS $(sw_vers -productVersion 2>/dev/null)"; else fail "macOS only (AE is driven through osascript)"; fi
  if command -v node >/dev/null 2>&1; then
    v="$(node -p 'process.versions.node' 2>/dev/null)"
    if [ "${v%%.*}" -ge 12 ] 2>/dev/null; then ok "node $v"; else fail "node $v is too old (need 12+)"; fi
  else
    fail "node not found (used for the syntax check/lint): brew install node"
  fi
  for v in ffmpeg ffprobe; do
    if command -v $v >/dev/null 2>&1; then ok "$v"; else warn "$v not found (needed by snap --sheet, sheet, frames, probe, selftest): brew install ffmpeg"; fi
  done
  if mkdir -p "$WORK" 2>/dev/null && [ -w "$WORK" ]; then ok "work dir $WORK"; else fail "cannot write the work dir $WORK (set AE_TMP)"; fi

  local bundle=""
  for v in "/Applications/$AE_APP/$AE_APP.app" "/Applications/$AE_APP.app"; do [ -d "$v" ] && bundle="$v"; done
  if [ -n "$bundle" ]; then ok "app '$AE_APP'"; else warn "'$AE_APP' not found in /Applications (set AE_APP to the app name)"; fi

  # "Allow Scripts to Write Files and Access Network": ae run reads the log file the script writes
  local year="${AE_APP##* }" pdir="$HOME/Library/Preferences/Adobe/After Effects" prefs="" d
  case "$year" in 20[0-9][0-9])
    local best=-1 m
    for d in "$pdir/$((year - 2000))".*; do   # newest minor version (26.10 after 26.5)
      m="${d##*.}"; [ "$m" -gt "$best" ] 2>/dev/null && { best=$m; prefs="$d"; }
    done
  esac
  [ -n "$prefs" ] && prefs="$prefs/Adobe After Effects ${prefs##*/} Prefs.txt"
  if [ -n "$prefs" ] && [ -f "$prefs" ]; then
    v="$(tr '\r' '\n' < "$prefs" | sed -n 's/.*"Pref_SCRIPTING_FILE_NETWORK_SECURITY" = "\{0,1\}\([0-9]*\)"\{0,1\}.*/\1/p' | head -1)"
    case "$v" in
      1|01) ok "scripts may write files (prefs ${prefs##*/})" ;;
      0|00) fail "scripts may not write files, so ae never sees the log. In AE: Settings > Scripting & Expressions > Allow Scripts to Write Files and Access Network" ;;
      *) warn "could not read the scripting pref in $prefs; make sure Settings > Scripting & Expressions > Allow Scripts to Write Files and Access Network is on" ;;
    esac
  else
    warn "AE prefs not found; make sure Settings > Scripting & Expressions > Allow Scripts to Write Files and Access Network is on"
  fi

  if ! command -v osascript >/dev/null 2>&1; then
    fail "osascript not found"
  elif ! ae_running; then
    warn "'$AE_APP' is not running: start it and run ae doctor again to test the connection"
  else
    # the first run makes macOS ask whether this terminal may control AE
    mkdir -p "$WORK/doctor"
    printf 'log("AE " + app.version);\n' > "$WORK/doctor/doctor.jsx"
    if v="$(RUN_TIMEOUT=20 run_jsx "$WORK/doctor/doctor.jsx" "$WORK/doctor/doctor.log" false "ae doctor" 2>&1)"; then
      ok "round trip: $(grep -m1 '^AE ' "$WORK/doctor/doctor.log")"
    else
      case "$v" in
        *-1743*|*"Not authorized"*|*"not allowed"*)
          fail "macOS blocks this terminal from controlling AE. System Settings > Privacy & Security > Automation: allow your terminal app to control '$AE_APP'" ;;
        *) fail "round trip failed (a modal dialog open in AE is the usual cause):"; echo "$v" | sed 's/^/      /' ;;
      esac
    fi
  fi
  [ $fails = 0 ] && { echo "no failures"; return 0; }
  return 1
}

# ae selftest [--keep]: generate a test clip, run tests/selftest.jsx in a throwaway comp, then tests/cleanup.jsx
cmd_selftest() {
  local keep=0
  [ "${1:-}" = "--keep" ] && keep=1
  need ffmpeg
  mkdir -p "$WORK/logs"
  local clip="$WORK/__aetools_clip.mp4" src="testsrc2=size=1280x720:rate=25:duration=6"
  if [ ! -f "$clip" ]; then
    ffmpeg -v error -y -f lavfi -i "$src" -c:v libx264 -pix_fmt yuv420p "$clip" 2>/dev/null \
      || ffmpeg -v error -y -f lavfi -i "$src" -c:v h264_videotoolbox "$clip" \
      || die "ffmpeg could not create $clip"
  fi
  local rc=0
  run_jsx "$TOOLS/tests/selftest.jsx" "$WORK/logs/selftest.log" false "selftest.jsx" || rc=$?
  if [ $keep = 0 ]; then
    QUIET=1 run_jsx "$TOOLS/tests/cleanup.jsx" "$WORK/logs/cleanup.log" false "cleanup.jsx" && echo "ae: cleanup done" >&2
  fi
  return $rc
}

usage() { sed -n '2,13p' "$SRC" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

cmd_check() {
  [ $# -ge 1 ] || die "usage: ae check script.jsx"
  need node
  mkdir -p "$WORK/run"
  nodejs prep "$1" "$WORK/run/check.prep.jsx" "$LIB" && echo "ok: $1"
}

cmd_run() {
  local script="" log="" undo=auto
  while [ $# -gt 0 ]; do
    case "$1" in
      --log) log="$2"; shift 2 ;;
      --ro) undo=false; shift ;;
      --undo) undo=true; shift ;;
      --timeout) RUN_TIMEOUT="$2"; shift 2 ;;
      -*) die "run: unknown option $1" ;;
      *) script="$1"; shift ;;
    esac
  done
  [ -n "$script" ] || die "usage: ae run script.jsx [--log file] [--ro|--undo] [--timeout s]"
  [ -f "$script" ] || die "no such file: $script"
  script="$(abspath "$script")"
  if [ -z "$log" ]; then
    case "$script" in
      "$TOOLS"/*) log="$WORK/logs/$(basename "${script%.jsx}").log" ;;  # keep the toolkit dir clean
      *) log="${script%.jsx}.log" ;;
    esac
  fi
  log="$(abspath "$log")"
  if [ "$undo" = auto ]; then
    # scripts that call AE.run/AE.peek/app.beginUndoGroup manage their own undo groups; plain scripts get one named after the file
    if grep -qE 'AE\.(run|peek)[[:space:]]*\(|app\.beginUndoGroup[[:space:]]*\(' "$script"; then undo=false; else undo=true; fi
  fi
  run_jsx "$script" "$log" "$undo" "$(basename "$script")"
}

cmd_eval() {
  local code="" undo=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --ro) undo=false; shift ;;
      *) code="${code:+$code
}$1"; shift ;;
    esac
  done
  [ -n "$code" ] || die "usage: ae eval 'js code' [--ro]   (an expression's value is logged)"
  mkdir -p "$WORK/eval"
  local f="$WORK/eval/eval.jsx"
  if [ "$(nodejs isexpr "$code")" = expr ]; then
    printf 'var __r = (%s\n);\nif (__r !== undefined) { log(__r); }\n' "$code" > "$f"
  else
    printf '%s\n' "$code" > "$f"
  fi
  run_jsx "$f" "$WORK/eval/eval.log" "$undo" "ae eval"
}

cmd_dump() {
  local comp="" depth=0 layer="" keys=true maxk=30 have=0 raw=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --depth) depth="$2"; shift 2 ;;
      --layer) layer="$2"; shift 2 ;;
      --no-keys) keys=false; shift ;;
      --max-keys) maxk="$2"; shift 2 ;;
      --raw-text) raw=true; shift ;;
      -*) die "dump: unknown option $1" ;;
      *) comp="$1"; have=1; shift ;;
    esac
  done
  [ $have = 1 ] || die "usage: ae dump \"Comp Name\" [--depth N] [--layer name] [--no-keys] [--max-keys N] [--raw-text]"
  mkdir -p "$WORK/dump"
  local f="$WORK/dump/dump.jsx" filt="null"
  [ -n "$layer" ] && filt="$(jsstr "$layer")"
  printf 'log(AE.dump(AE.comp(%s), {depth: %d, keys: %s, maxKeys: %d, filter: %s, rawText: %s}));\n' \
    "$(jsstr "$comp")" "$depth" "$keys" "$maxk" "$filt" "$raw" > "$f"
  # --raw-text toggles text expressions off/on to read the source text: one undo step "ae dump"
  run_jsx "$f" "$WORK/dump/dump.log" "$raw" "ae dump"
}

cmd_tree() {
  local main="null"
  [ "${1:-}" = "--main" ] && main="$(jsstr "$2")"
  mkdir -p "$WORK/tree"
  printf 'log(AE.tree(%s));\n' "$main" > "$WORK/tree/tree.jsx"
  run_jsx "$WORK/tree/tree.jsx" "$WORK/tree/tree.log" false "ae tree"
}

# "8,44,90" / "10-100:10" / "0-20" -> "8,44,90"
parse_frames() {
  local spec="$1" out="" part a b step f
  local IFS=','
  for part in $spec; do
    case "$part" in
      *-*)
        a="${part%%-*}"; b="${part#*-}"; step=1
        case "$b" in *:*) step="${b#*:}"; b="${b%%:*}" ;; esac
        [ "$step" -gt 0 ] 2>/dev/null || die "bad step in '$part'"
        f=$a; while [ "$f" -le "$b" ]; do out="$out${out:+,}$f"; f=$((f + step)); done ;;
      *) out="$out${out:+,}$part" ;;
    esac
  done
  case "$out" in ''|*[!0-9.,]*) die "bad frame list '$spec' (use 8,44,90 or 10-100:10)" ;; esac
  echo "$out"
}

cmd_snap() {
  local comp="" frames="" out="" prefix="" res="half" sheet=0 cols=4 width=640 n=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out="$2"; shift 2 ;;
      --prefix) prefix="$2"; shift 2 ;;
      --res) res="$2"; shift 2 ;;
      --sheet) sheet=1; shift ;;
      --cols) cols="$2"; shift 2 ;;
      --width) width="$2"; shift 2 ;;
      --timeout) SNAP_TIMEOUT="$2"; shift 2 ;;
      -*) die "snap: unknown option $1" ;;
      *) if [ $n = 0 ]; then comp="$1"; else frames="$1"; fi; n=$((n + 1)); shift ;;
    esac
  done
  [ -n "$comp" ] && [ -n "$frames" ] || die "usage: ae snap \"Comp\" 8,44,90 [--out dir] [--prefix p] [--res full|half|third|quarter] [--sheet] [--cols N] [--width px]"
  case "$res" in full|half|third|quarter) ;; *) die "--res must be full|half|third|quarter" ;; esac
  frames="$(parse_frames "$frames")" || exit 2
  [ -n "$prefix" ] || prefix="$(printf '%s' "$comp" | tr -c 'A-Za-z0-9_-' '_')"
  [ -n "$out" ] || out="$WORK/snap/$prefix"
  out="$(abspath "$out")"; mkdir -p "$out"
  local f="$WORK/snap/snap.jsx"; mkdir -p "$WORK/snap"
  printf 'AE.snap(AE.comp(%s), [%s], %s, %s, %s);\n' "$(jsstr "$comp")" "$frames" "$(jsstr "$out")" "$(jsstr "$prefix")" "$(jsstr "$res")" > "$f"
  QUIET=1 run_jsx "$f" "$WORK/snap/snap.log" false "ae snap" || exit $?
  local pairs=() line p fr
  while IFS= read -r line; do
    p="${line#PNG }"; echo "$p"
    fr="${p##*_f}"; fr="${fr%.png}"; fr=$((10#$fr))
    pairs+=("f$fr" "$p")
  done < <(grep '^PNG ' "$WORK/snap/snap.log")
  if [ $sheet = 1 ] && [ ${#pairs[@]} -gt 0 ]; then
    make_sheet "$out/${prefix}_sheet.png" "$cols" "$width" "${pairs[@]}"
    echo "SHEET $out/${prefix}_sheet.png"
  fi
}

cmd_sheet() {
  local out="" cols=4 width=640 pairs=() f
  while [ $# -gt 0 ]; do
    case "$1" in
      --cols) cols="$2"; shift 2 ;;
      --width) width="$2"; shift 2 ;;
      *) if [ -z "$out" ]; then out="$1"; else pairs+=("$(basename "${1%.*}")" "$1"); fi; shift ;;
    esac
  done
  [ -n "$out" ] && [ ${#pairs[@]} -gt 0 ] || die "usage: ae sheet out.png a.png b.png ... [--cols N] [--width px]"
  make_sheet "$(abspath "$out")" "$cols" "$width" "${pairs[@]}"
  echo "$(abspath "$out")"
}

probe_vals() {  # prints: width height r_frame_rate avg_frame_rate nb_frames codec duration
  ffprobe -v error -select_streams v:0 \
    -show_entries stream=width,height,r_frame_rate,avg_frame_rate,nb_frames,codec_name:format=duration \
    -of default=nw=1 "$1"
}

cmd_probe() {
  need ffprobe
  local vid="" cfps=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --fps) cfps="$2"; shift 2 ;;
      -*) die "probe: unknown option $1" ;;
      *) vid="$1"; shift ;;
    esac
  done
  [ -n "$vid" ] && [ -f "$vid" ] || die "usage: ae probe video.mp4 [--fps N]"
  set -- "$vid"
  local k v W="" H="" R="" AVG="" NB="" C="" DUR=""
  while IFS='=' read -r k v; do
    case "$k" in
      width) W=$v ;; height) H=$v ;; r_frame_rate) R=$v ;; avg_frame_rate) AVG=$v ;;
      nb_frames) NB=$v ;; codec_name) C=$v ;; duration) DUR=$v ;;
    esac
  done < <(probe_vals "$1")
  local rot aud fps rfps
  rot=$(ffprobe -v error -select_streams v:0 -show_entries stream_side_data=rotation -of default=nw=1:nk=1 "$1" | head -1)
  aud=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of csv=p=0 "$1" | head -1)
  fps=$(awk -v r="$AVG" 'BEGIN{split(r,a,"/"); if (a[2]+0>0) printf "%.3f", a[1]/a[2]; else print "?"}')
  rfps=$(awk -v r="$R" 'BEGIN{split(r,a,"/"); if (a[2]+0>0) printf "%.3f", a[1]/a[2]; else print "?"}')
  echo "file=$1"
  echo "width=$W height=$H${rot:+ rotation=$rot}"
  echo "fps=$fps (avg_frame_rate=$AVG r_frame_rate=$R${rfps:+ = $rfps})$( [ "$AVG" != "$R" ] && echo '  VFR?')"
  echo "duration=${DUR}s frames=${NB:-?} codec=$C audio=${aud:-none}"
  [ -n "$cfps" ] && awk -v d="$DUR" -v f="$cfps" 'BEGIN{ if (d+0>0) printf "at %sfps: %.1f comp frames\n", f, d*f }'
  return 0
}

cmd_frames() {
  need ffmpeg; need ffprobe
  local vid="" n=12 cols=4 width=480 from="" to="" out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --n) n="$2"; shift 2 ;;
      --cols) cols="$2"; shift 2 ;;
      --width) width="$2"; shift 2 ;;
      --from) from="$2"; shift 2 ;;
      --to) to="$2"; shift 2 ;;
      --out) out="$2"; shift 2 ;;
      -*) die "frames: unknown option $1" ;;
      *) vid="$1"; shift ;;
    esac
  done
  [ -n "$vid" ] && [ -f "$vid" ] || die "usage: ae frames video.mp4 [--n 12] [--cols 4] [--width 480] [--from s] [--to s] [--out sheet.png]"
  local k v AVG="" DUR=""
  while IFS='=' read -r k v; do
    case "$k" in avg_frame_rate) AVG=$v ;; duration) DUR=$v ;; esac
  done < <(probe_vals "$vid")
  [ -n "$from" ] || from=0
  [ -n "$to" ] || to="$DUR"
  local base; base="$(basename "${vid%.*}" | tr -c 'A-Za-z0-9_-' '_')"
  local dir="$WORK/frames/$base"; mkdir -p "$dir"
  rm -f "$dir"/cell_*.png
  [ -n "$out" ] || out="$WORK/frames/${base}_sheet.png"
  local pairs=() i=0 t sf png
  while [ $i -lt "$n" ]; do
    t=$(awk -v a="$from" -v b="$to" -v i="$i" -v n="$n" 'BEGIN{printf "%.3f", a+(b-a)*(i+0.5)/n}')
    sf=$(awk -v t="$t" -v r="$AVG" 'BEGIN{split(r,x,"/"); if (x[2]+0>0) printf "%d", t*x[1]/x[2]+0.5; else print "?"}')
    png="$dir/cell_$(printf '%03d' $i).png"
    ffmpeg -v error -y -ss "$t" -i "$vid" -frames:v 1 -vf "scale=$width:-2" -update 1 "$png" || die "ffmpeg failed at t=$t"
    printf '%2d  t=%ss  srcframe=%s\n' "$i" "$t" "$sf"
    pairs+=("$i  ${t}s  f$sf" "$png")
    i=$((i + 1))
  done
  make_sheet "$(abspath "$out")" "$cols" "$width" "${pairs[@]}"
  echo "SHEET $(abspath "$out")"
}

# ---------------------------------------------------------------- main
[ $# -ge 1 ] || usage 2
cmd="$1"; shift
case "$cmd" in
  run) cmd_run "$@" ;;
  eval) cmd_eval "$@" ;;
  check) cmd_check "$@" ;;
  dump) cmd_dump "$@" ;;
  tree) cmd_tree "$@" ;;
  snap) cmd_snap "$@" ;;
  sheet) cmd_sheet "$@" ;;
  frames) cmd_frames "$@" ;;
  probe) cmd_probe "$@" ;;
  save) cmd_save "$@" ;;
  doctor) cmd_doctor "$@" ;;
  selftest) cmd_selftest "$@" ;;
  -h|--help|help) usage 0 ;;
  *) echo "ae: unknown command '$cmd'" >&2; usage 2 ;;
esac
