#!/usr/bin/env node
// ae / aectl: drive Adobe After Effects from the shell. The CLI is dist/ae.mjs, built from src/ (npm run build).
// This file stays plain old JavaScript so an old node prints a clear message instead of a syntax error.
var major = Number(process.versions.node.split(".")[0]);
if (major < 22) {
  process.stderr.write("ae: node 22 or newer is required (found " + process.versions.node + ")\n");
  process.exit(2);
}
import("./dist/ae.mjs");
