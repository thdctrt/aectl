#compdef ae aectl
# zsh completion for ae / aectl. Either
#   eval "$(ae completion zsh)"                      in ~/.zshrc, or
#   ae completion zsh > ~/.zfunc/_ae                 with ~/.zfunc in $fpath before compinit.
# Comp and layer names come from the running AE (read-only, empty when AE is not running).

_ae_names() {  # _ae_names <tag> <description> <ae _names args...>
  local tag=$1 descr=$2 expl; shift 2
  local -a names
  names=(${(f)"$(_call_program $tag ${(q)_ae_bin} _names ${(q)@} 2>/dev/null)"})
  _wanted $tag expl $descr compadd -a names
}
_ae_comps() { _ae_names comps 'comp' comps; }
_ae_comp_or_audio() { _alternative 'comps:comp:_ae_comps' 'files:audio file:_files -g "*.(#i)(wav|mp3|aif|aiff|m4a|aac|flac|mov|mp4)(-.)"'; }
_ae_layers() {
  local comp=${(Q)line[1]}    # first positional argument, set by _arguments
  [[ -n $comp ]] && _ae_names layers 'layer' layers "$comp"
}

_ae() {
  local _ae_bin=$words[1] curcontext=$curcontext state line
  local -a cmds
  cmds=(
    'run:lint and run a .jsx as one undo step'
    'eval:run JS (the last expression is printed)'
    'check:syntax + ES3 lint only'
    'dump:print one comp in detail'
    'tree:project overview + layers of the active comp'
    'sel:active comp, playhead, selected layers/properties/keys'
    'markers:comp and layer markers with comments'
    'mark:add a marker'
    'health:missing footage/fonts, expression errors, off-screen layers'
    'find:search names, text, expressions, files, effects, markers'
    'effects:search installed effects'
    'graph:value and speed curves of a property'
    'snap:render comp frames to PNG'
    'sheet:contact sheet from images'
    'measure:ink bounding box of an image, or how far one is off from another'
    'frames:sample a video into a contact sheet'
    'probe:video size, fps, duration'
    'beats:music accents in comp frames'
    'export:render a comp and encode it for YouTube, Reels, web, ProRes, GIF...'
    'save:save the open project'
    'doctor:check the setup'
    'selftest:run the self-test in a throwaway comp'
    'completion:print the shell completion script'
    'mcp:MCP server on stdin/stdout'
    'help:show usage'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'ae command' cmds
    return
  fi
  local cmd=$words[2]
  curcontext="${curcontext%:*}-$cmd:"
  shift words; (( CURRENT-- ))

  local video='_files -g "*.(#i)(mp4|mov|m4v|mkv|webm|avi)(-.)"'
  local sheetopts=('--cols[sheet columns]:columns:' '--width[cell width in px]:px:')
  case $cmd in
    run)
      _arguments \
        '1:script:_files -g "*.jsx(-.)"' \
        '--log[log file]:log file:_files' \
        '(--undo)--ro[no undo group]' \
        '(--ro)--undo[force one undo group]' \
        '--no-rollback[keep what a failed run changed]' \
        '--timeout[seconds to wait for the log]:seconds:' \
        '--diff[print what the script changed]' \
        '--ab[before/after sheet of this comp]:comp:_ae_comps' \
        '--frames[frames for --ab]:frames:' \
        '--res[render resolution for --ab]:resolution:(full half third quarter)' \
        '--crop[region for --ab, comp pixels]:x,y,w,h:' \
        '--cols[sheet columns]:columns:' \
        '--width[sheet cell width in px]:px:' ;;
    check)
      _arguments '1:script:_files -g "*.jsx(-.)"' ;;
    eval)
      _arguments '1:js code:' '--ro[no undo group]' '--no-rollback[keep what a failed run changed]' ;;
    dump)
      _arguments \
        '1:comp:_ae_comps' \
        '--depth[recurse into precomps]:depth:' \
        '--layer[only this layer]:layer:_ae_layers' \
        '--no-keys[omit keyframes]' \
        '--max-keys[keys shown per property]:count:' \
        '--at[values at this comp frame]:frame:' \
        '--props[also every changed static value (shape contents, masks, text animators)]' \
        '--raw-text[true Source Text (one undo step)]' ;;
    sel|mcp)
      ;;
    markers)
      _arguments '1:comp:_ae_comps' '--all[every comp]' ;;
    mark)
      _arguments \
        '1:comp:_ae_comps' \
        '2:frame:' \
        '3:comment:' \
        '--layer[put it on this layer]:layer:_ae_layers' \
        '--dur[length in frames]:frames:' \
        '--label[label colour 0-16]:label:' ;;
    health)
      _arguments '1:comp:_ae_comps' '--all[every comp]' '--safe[text safe margin, % of each side]:percent:' ;;
    find)
      _arguments \
        '1:text:' \
        '--in[scopes]:scopes:_values -s , scope name text expr file effect marker' \
        '--comp[only this comp]:comp:_ae_comps' \
        '--regex[text is a regular expression]' ;;
    effects)
      _arguments '*:word:' '--refresh[re-read the list from AE]' ;;
    graph)
      _arguments \
        '1:comp:_ae_comps' \
        '2:layer:_ae_layers' \
        '3:property path (Transform/Position, pos, scale, rot, opacity):' \
        '--from[first frame]:frame:' \
        '--to[last frame]:frame:' \
        '--step[sample every N frames]:frames:' \
        '--out[png file]:file:_files -g "*.png(-.)"' \
        '--width[px]:px:' \
        '--height[px]:px:' ;;
    tree)
      _arguments '--main[comp whose layers to list]:comp:_ae_comps' ;;
    snap)
      _arguments \
        '1:comp:_ae_comps' \
        '2:frames (8,44,90 or 0-120\:10):' \
        '--out[output dir]:dir:_files -/' \
        '--prefix[file name prefix]:prefix:' \
        '--res[render resolution]:resolution:(full half third quarter)' \
        '--crop[region in comp pixels]:x,y,w,h:' \
        '--sheet[also build a contact sheet]' \
        '--timeout[seconds to wait for the PNGs]:seconds:' \
        $sheetopts ;;
    sheet)
      _arguments \
        '1:output png:_files -g "*.png(-.)"' \
        '*:image:_files -g "*.(#i)(png|jpg|jpeg)(-.)"' \
        $sheetopts ;;
    beats)
      _arguments \
        '1:comp or audio file:_ae_comp_or_audio' \
        '--layer[the audio layer]:layer:_ae_layers' \
        '--from[first comp frame]:frame:' \
        '--to[last comp frame]:frame:' \
        '--top[only the N strongest]:count:' \
        '--min-gap[merge onsets closer than this, in frames]:frames:' \
        '--threshold[drop onsets weaker than this share of the strongest]:0-1:' \
        '--env[also loudness per frame]' \
        '--fps[file only: comp frame rate]:fps:' \
        '--offset[file only: comp frame where the file starts]:frame:' \
        '--mark[add a marker at each accent on the layer]' \
        '--label[with --mark: marker label 0-16]:label:' ;;
    measure)
      _arguments \
        '1:image:_files -g "*.(#i)(png|jpg|jpeg)(-.)"' \
        '2:image to compare:_files -g "*.(#i)(png|jpg|jpeg)(-.)"' \
        '--box[search only this region]:x,y,w,h:' \
        '--bg[background colour]:#RRGGBB:' \
        '--threshold[difference from the background that counts as ink]:0-255:' ;;
    frames)
      _arguments \
        "1:video:$video" \
        '--n[number of cells]:count:' \
        '--from[start, seconds]:seconds:' \
        '--to[end, seconds]:seconds:' \
        '--out[sheet png]:file:_files -g "*.png(-.)"' \
        $sheetopts ;;
    probe)
      _arguments "1:video:$video" '--fps[also print the length in comp frames]:fps:' ;;
    export)
      _arguments \
        '1:comp:_ae_comps' \
        '--preset[output preset]:preset:(youtube-1080 youtube-4k shorts reels tiktok square web prores prores-alpha webm-alpha gif)' \
        '--out[output file]:file:_files' \
        '(--from --to)--full[whole comp instead of the work area]' \
        '(--full)--from[first comp frame]:frame:' \
        '(--full)--to[last comp frame]:frame:' \
        '--fit[when the aspect differs]:fit:(pad crop)' \
        '--force[overwrite the output file]' \
        '--keep-intermediate[keep the master AE rendered]' \
        '--timeout[seconds to wait for the render]:seconds:' \
        '--ame[encode in Adobe Media Encoder]' \
        '--wait[with --ame: wait for the file]' \
        '--list[list the presets]' ;;
    save)
      _arguments \
        '--status[only report path and unsaved changes]' \
        '--backup[copy the .aep to Backups/ first]' \
        '--as[save to a new file]:project:_files -g "*.aep(|x)(-.)"' ;;
    selftest)
      _arguments '--keep[leave the test items in the project]' ;;
    completion)
      _arguments '1:shell:(zsh)' ;;
  esac
}

if [[ $funcstack[1] == _ae ]]; then
  _ae "$@"                                   # autoloaded from $fpath
else
  (( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
  compdef _ae ae aectl                       # sourced / eval'd
fi
